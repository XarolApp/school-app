# Backend config (server.js) — copy to .env, fill in real values, never commit .env.
# On Railway: set these as service variables instead of a file.

# Required to boot
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backend port. Railway injects its own PORT automatically — leave unset there.
# On the MacBook use 5001: macOS AirPlay Receiver already listens on 5000.
PORT=5000

# Set to "production" on Railway. Without it BETA_TICKET_SECRET silently falls
# back to the service-role key (server.js), which must never happen in prod.
NODE_ENV=

# The deployed frontend's origin (no trailing slash). Used for CORS, Stripe
# success/cancel redirect URLs, and the OpenRouter HTTP-Referer header.
# Local dev: http://localhost:5173
# Production: https://www.stredninamiru.cz (the www host; apex redirects to it)
FRONTEND_URL=http://localhost:5173

# Set to "true" on Railway (or any host behind a reverse proxy) so
# express-rate-limit reads the real client IP instead of the proxy's.
# Leave unset for local dev.
TRUST_PROXY=

# Comma-separated allowlist of emails that get permanent developer access
# (bypasses the trial/paywall). Never expose this logic client-side.
DEVELOPER_EMAILS=

# Comma-separated verified emails allowed to use /admin. Server-side only;
# developer access does not grant admin access (and vice versa).
ADMIN_EMAILS=

# Keep school reviews disabled while beta feedback is collected. Beta website
# testimonials use a separate consented flow.
SCHOOL_REVIEWS_ENABLED=false

# Dedicated secret for beta invitation tracking tickets (random 32+ bytes).
# Required in production; development alone may fall back to the service key.
BETA_TICKET_SECRET=

# Questionnaire explanations and cached school pros/cons. Defaults are GPT-6
# Luna (`openai/gpt-6-luna`) through OpenRouter's `openai/flex` provider. Matching
# and scores remain deterministic JavaScript. Without a key/credits, runs still
# score and save; on-demand explanations show an inline unavailable message.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_PROSCONS_MODEL=openai/gpt-6-luna
OPENROUTER_PROVIDER=openai/flex
OPENROUTER_EXTRACT_MODEL=

# Google Gemini API — alternative to OpenRouter for extraction.
# Leave blank to use OpenRouter. If set, scripts/extract-school-details.js will use
# this instead. You can provide up to 2 comma-separated keys to round-robin across
# accounts (avoids hitting 3 RPM per-key rate limit).
GOOGLE_GEMINI_API_KEYS=
GOOGLE_GEMINI_MODEL=gemini-3.6-flash

# Stripe — plan 009, revised. Monthly is a real subscription (needs
# STRIPE_PRICE_ID_MONTHLY, a Stripe Price). Season is a genuine one-time
# charge — mode:'setup' saves a card, then server.js's chargeDueSeasonPasses()
# bills it once after the trial — so it has NO Stripe Price and
# STRIPE_PRICE_ID_SEASON is unused; leave it blank. Use TEST MODE keys
# (sk_test_...) until an adult owns the Stripe account; no code change is
# needed to go live later, only swapping these for sk_live_... values.
# /api/checkout answers 503 without STRIPE_SECRET_KEY.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_SEASON=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_WEBHOOK_SECRET=

# scripts/scrape-schools.js + scripts/extract-school-details.js — the
# school-website scrape/extraction pipeline (docs/firecrawl-extraction-task.md).
# Phase 2 goes through OpenRouter (OPENROUTER_API_KEY above), not a direct
# Anthropic key. Only Phase 1 needs its own key.
FIRECRAWL_API_KEY=

# Optional tuning for scripts/extract-school-details.js (scripts only, never Railway):
# OPENROUTER_API_KEYS=key1,key2   round-robin keys (falls back to OPENROUTER_API_KEY)
# OPENROUTER_EXTRACT_PROVIDER=    e.g. openai/flex for the half-price flex route
# OPENROUTER_EXTRACT_EFFORT=low   reasoning effort
# EXTRACT_INPUT_DIR=              defaults to scripts/data/filtered-schools
# EXTRACT_DUMP_DIR=               write raw model replies here for debugging
# SCRAPE_PAGES_PER_SCHOOL=        scripts/scrape-schools-free.js page limit
