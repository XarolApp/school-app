# Backend config (server.js) — copy to .env, fill in real values, never commit .env.
# On Railway: set these as service variables instead of a file.

# Required to boot
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backend port. Railway injects its own PORT automatically — leave unset there.
PORT=5000

# The deployed frontend's origin (no trailing slash). Used for CORS, Stripe
# success/cancel redirect URLs, and the OpenRouter HTTP-Referer header.
# Local dev: http://localhost:5173
# Production: your Vercel URL, e.g. https://skolamatch.vercel.app
FRONTEND_URL=http://localhost:5173

# Set to "true" on Railway (or any host behind a reverse proxy) so
# express-rate-limit reads the real client IP instead of the proxy's.
# Leave unset for local dev.
TRUST_PROXY=

# Comma-separated allowlist of emails that get permanent developer access
# (bypasses the trial/paywall). Never expose this logic client-side.
DEVELOPER_EMAILS=

# Standalone questionnaire's AI call. Without this, /api/questionnaire's
# POST route answers 503 (AI_NOT_CONFIGURED) but everything else still works.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_PROSCONS_MODEL=

# Stripe — plan 009. Both plans are Stripe subscriptions (the season pass is a
# subscription with a 3-day trial + an absolute cancel_at, so it charges once
# and expires — see plan 009 §1). Use TEST MODE keys (sk_test_...) until an
# adult owns the Stripe account; no code change is needed to go live later,
# only swapping these for sk_live_... values. /api/checkout answers 503
# without them.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_SEASON=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_WEBHOOK_SECRET=
