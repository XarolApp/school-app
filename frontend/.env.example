# Frontend config (Vite) — copy to frontend/.env, fill in real values, never commit .env.
# On Vercel: set these as Project → Settings → Environment Variables instead.
# All VITE_* vars are baked into the build and are PUBLIC — never put a
# service-role key or any server secret in here.

# The deployed backend's URL (no trailing slash).
# Local dev: http://localhost:5000 (or http://localhost:5001 if 5000 is taken
# — see CLAUDE.md, macOS AirPlay Receiver claims port 5000)
# Production: https://school-app-production-be43.up.railway.app
# Public backend origin used for app API requests.
VITE_API_BASE_URL=http://localhost:5000

# Public single-school beta cohort code (baked into the bundle). Use the uppercase
# form of the shared tester code; new signups still confirm role and data-use notice.
VITE_BETA_SCHOOL_CODE=PRISTUPTESTOVACIVERZE

# Supabase — the anon/public key, safe to expose client-side. NOT the
# service-role key (that stays server-only, see the root .env.example).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (public). Without it the CAPTCHA widget
# renders nothing. This does not disable Supabase's hosted CAPTCHA requirement:
# if it is enabled there, configure the matching site key before testing auth.
VITE_TURNSTILE_SITE_KEY=

# Vercel only, NOT prefixed VITE_: SITE_ACCESS_KEY is the site-wide tester code
# (`pristuptestovaciverze`, same code as VITE_BETA_SCHOOL_CODE, normalized).
# Middleware accepts it by POST and stores only an HMAC in the browser cookie.
# Unset = open locally/previews, closed in production.
# SITE_ACCESS_KEY=
