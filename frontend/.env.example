# Frontend config (Vite) — copy to frontend/.env, fill in real values, never commit .env.
# On Vercel: set these as Project → Settings → Environment Variables instead.
# All VITE_* vars are baked into the build and are PUBLIC — never put a
# service-role key or any server secret in here.

# The deployed backend's URL (no trailing slash).
# Local dev: http://localhost:5000 (or http://localhost:5001 if 5000 is taken
# — see CLAUDE.md, macOS AirPlay Receiver claims port 5000)
# Production: https://school-app-production-be43.up.railway.app
# Public backend origin used for app API requests.
VITE_API_BASE_URL=http://localhost:5000

# Optional single-school beta cohort code. New signups still confirm their role
# and acknowledge the beta data-use notice before an account is created.
# VITE_BETA_SCHOOL_CODE=

# Supabase — the anon/public key, safe to expose client-side. NOT the
# service-role key (that stays server-only, see the root .env.example).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (public). Without it the CAPTCHA widget
# renders nothing and auth forms still work.
VITE_TURNSTILE_SITE_KEY=

# Vercel only, NOT prefixed VITE_ (that would publish it): SITE_ACCESS_KEY is
# the site-wide tester code. The middleware accepts it by POST and keeps only
# an HMAC in the browser cookie. Unset = open locally/previews, closed in production.
# SITE_ACCESS_KEY=
