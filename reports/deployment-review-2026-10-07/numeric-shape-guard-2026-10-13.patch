+++ b/tests/questionnaire-number-shape.test.cjs
@@ -0,0 +1,29 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { validateAnswers } = require('../lib/questionnaire');
+
+const base = {
+  typ: 'odborna', oblasti: ['it'], predmety: ['informatika'],
+  styl: 'kombinace', po_skole: 'nevim', velikost: 'nezalezi', jazyky: 'stredne',
+};
+
+test('questionnaire exam points reject non-scalar and blank coercions', () => {
+  for (const body of [true, false, [], [12], {}, ' ', '\t\n']) {
+    const result = validateAnswers({ ...base, body });
+    assert.equal(result.ok, false, JSON.stringify(body));
+    assert.match(result.error, /celé číslo 0–100/);
+  }
+});
+
+test('questionnaire exam points preserve valid boundaries and optional omission', () => {
+  for (const body of [0, 100, '0', '100', ' 12 ']) {
+    const result = validateAnswers({ ...base, body });
+    assert.equal(result.ok, true, JSON.stringify(body));
+    assert.equal(result.answers.body, Number(body));
+  }
+  for (const body of ['', null, undefined]) {
+    const result = validateAnswers({ ...base, body });
+    assert.equal(result.ok, true);
+    assert.equal(Object.hasOwn(result.answers, 'body'), false);
+  }
+});
